FLASK_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this URL as an authorized redirect URI for your Google OAuth client
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth/callback
# Optional: enables AI-generated drafts; otherwise safe template suggestions are used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to 1 to enable local development HTTPS exemption, only for localhost
OAUTHLIB_INSECURE_TRANSPORT=1
